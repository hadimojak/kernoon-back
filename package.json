{
  "name": "kernoon-back",
  "version": "0.0.1",
  "description": "Kernoon ecommerce microservices",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "npm run build:apps",
    "build:apps": "nest build api-gateway && nest build identity && nest build catalog && nest build cart && nest build orders && nest build account && nest build sellers",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start api-gateway",
    "infra:up": "docker compose --env-file .env.development up -d --wait postgres redis rabbitmq",
    "infra:down": "docker compose --env-file .env.development stop postgres redis rabbitmq",
    "start:dev": "npm run infra:up && npm run start:dev:all",
    "start:dev:all": "concurrently -n gateway,identity,catalog,cart,orders,account,sellers -c cyan,green,yellow,blue,magenta,white,gray \"npm:start:dev:gateway\" \"npm:start:dev:identity\" \"npm:start:dev:catalog\" \"npm:start:dev:cart\" \"npm:start:dev:orders\" \"npm:start:dev:account\" \"npm:start:dev:sellers\"",
    "start:dev:gateway": "nest start api-gateway --watch",
    "start:dev:identity": "nest start identity --watch",
    "start:dev:catalog": "nest start catalog --watch",
    "start:dev:cart": "nest start cart --watch",
    "start:dev:orders": "nest start orders --watch",
    "start:dev:account": "nest start account --watch",
    "start:dev:sellers": "nest start sellers --watch",
    "start:prod": "node dist/apps/api-gateway/main",
    "start:prod:gateway": "node dist/apps/api-gateway/main",
    "start:prod:identity": "node dist/apps/identity/main",
    "start:prod:catalog": "node dist/apps/catalog/main",
    "start:prod:cart": "node dist/apps/cart/main",
    "start:prod:orders": "node dist/apps/orders/main",
    "start:prod:account": "node dist/apps/account/main",
    "start:prod:sellers": "node dist/apps/sellers/main",
    "lint": "eslint \"{apps,libs}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "docker:build": "docker compose --env-file .env.development --profile apps build",
    "docker:build:prod": "docker compose --env-file .env.production --profile apps build",
    "docker:swarm:prod": "node scripts/swarm-deploy.mjs .env.production",
    "docker:swarm:down": "docker stack rm kernoon"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": ["apps/**/*.(t|j)s", "libs/**/*.(t|j)s"],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": ["<rootDir>/apps/", "<rootDir>/libs/"],
    "moduleNameMapper": {
      "^@app/common$": "<rootDir>/libs/common/src",
      "^@app/common/(.*)$": "<rootDir>/libs/common/src/$1",
      "^@app/contracts$": "<rootDir>/libs/contracts/src",
      "^@app/contracts/(.*)$": "<rootDir>/libs/contracts/src/$1"
    }
  }
}
