# Local Swarm reads .env.development.
# The server for www.kernoon.ir reads .env.production.
# Replace the production secrets before that deploy.

# SMS login codes. Without these, development logs the code.
# KAVENEGAR_API_KEY=
# KAVENEGAR_SENDER=

# Email login codes. Without these, development logs the code.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Kernoon <no-reply@kernoon.ir>
